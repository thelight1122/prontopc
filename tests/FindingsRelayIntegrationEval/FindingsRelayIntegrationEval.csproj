<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ProntoPC.FindingsRelayIntegrationEval</RootNamespace>
  </PropertyGroup>
  <!-- Engine-free shipping sources (the PodEval set) + the pure Governance relay + the integration.
       Orchestrator.cs/Repair.cs are excluded on purpose (Windows). -->
  <ItemGroup>
    <Compile Include="..\..\StoreApp\Envelope.cs" />
    <Compile Include="..\..\StoreApp\PlanContracts.cs" />
    <Compile Include="..\..\StoreApp\SystemAudit.cs" />
    <Compile Include="..\..\StoreApp\LocalPlanner.cs" />
    <Compile Include="..\..\StoreApp\CustodianChat.cs" />
    <Compile Include="..\..\StoreApp\FindingsRelayIntegration.cs" />
    <Compile Include="..\..\StoreApp\Governance\*.cs" Link="Governance\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
