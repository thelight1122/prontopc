<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CoherenceObservers</AssemblyName>
    <RootNamespace>ProntoPC.Coherence</RootNamespace>
  </PropertyGroup>

  <!-- Deterministic coherence observers for Canon formation (Phase 0). The envelope-coherence
       observer (C3) reuses the REAL shipping Envelope.Validate, exactly as PodEval does, so the
       boundary it observes is the same one the app enforces — not a copy. -->
  <ItemGroup>
    <Compile Include="..\..\StoreApp\Envelope.cs" />
  </ItemGroup>

</Project>
