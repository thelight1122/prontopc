<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PodEval</AssemblyName>
    <RootNamespace>ProntoPC.Eval</RootNamespace>
  </PropertyGroup>

  <!-- Compile the real plan logic directly, so the eval runs the shipping code, not a copy. -->
  <ItemGroup>
    <Compile Include="..\..\StoreApp\Envelope.cs" />
    <Compile Include="..\..\StoreApp\PlanContracts.cs" />
    <Compile Include="..\..\StoreApp\SystemAudit.cs" />
    <Compile Include="..\..\StoreApp\LocalPlanner.cs" />
    <Compile Include="..\..\StoreApp\NatureLayerContext.cs" />
    <Compile Include="..\..\StoreApp\Orchestrator.cs" />
    <Compile Include="..\..\StoreApp\Repair.cs" />
    <Compile Include="..\..\StoreApp\CustodianChat.cs" />
    <EmbeddedResource Include="..\..\pod\orbs\repair-engine\action-envelope.json" Link="action-envelope.json" />
  </ItemGroup>

</Project>
