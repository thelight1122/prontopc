<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PodEval</AssemblyName>
    <RootNamespace>ProntoPC.Eval</RootNamespace>
  </PropertyGroup>

  <!-- Compile the real plan logic directly (engine-free files only), so the eval runs the
       shipping code, not a copy. Orchestrator.cs/Repair.cs are excluded on purpose (Windows). -->
  <ItemGroup>
    <Compile Include="..\..\StoreApp\Envelope.cs" />
    <Compile Include="..\..\StoreApp\PlanContracts.cs" />
    <Compile Include="..\..\StoreApp\LocalPlanner.cs" />
    <Compile Include="..\..\StoreApp\CustodianChat.cs" />
  </ItemGroup>

</Project>
