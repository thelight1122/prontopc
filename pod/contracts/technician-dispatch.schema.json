{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prontopc.local/schemas/technician-dispatch.schema.json",
  "title": "Technician Dispatch Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "dispatch_id",
    "technician_profile_id",
    "intent",
    "mode",
    "selected_satellite",
    "consent_required",
    "decision_basis"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "technician_profile_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "intent": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["read-only", "repair"] },
    "selected_satellite": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "actuator_intent": { "type": "string" },
    "consent_required": { "type": "boolean" },
    "decision_basis": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "rejected_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
