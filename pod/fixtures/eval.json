    {
      "name": "clean_healthy_pc",
      "diagnostics": { "memory": {"percent_used": 40}, "network": {"connectivity": {"internet_reachable": true}}, "dns_cache": {"entries": 0}, "update_leftovers": {"windows_old_present": false, "windows_update_cache_mb": 0, "delivery_optimization_mb": 0} },
      "includes": ["disk_cleanup", "clear_windows_caches", "optimize_power_plan", "clean_component_store", "clear_windows_store_cache"],
      "excludes": ["clear_temp_files", "remove_windows_old", "sfc_scan", "reset_network_stack", "flush_dns", "empty_recycle_bin", "clean_windows_update_cache", "disable_startup_item", "optimize_visual_effects", "driver_report", "hardware_report"]
    },
    {
      "name": "temp_and_recycle_clutter",
      "diagnostics": { "temp_files": [{"path": "t", "size_mb": 300}], "recycle_bin": {"size_mb": 500}, "memory": {"percent_used": 45}, "network": {"connectivity": {"internet_reachable": true}}, "dns_cache": {"entries": 0}, "update_leftovers": {"windows_old_present": false, "windows_update_cache_mb": 0, "delivery_optimization_mb": 0} },
      "includes": ["clear_temp_files", "empty_recycle_bin"],
      "excludes": ["remove_windows_old", "reset_network_stack"]
    },
    {
