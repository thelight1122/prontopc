      "diagnostics": { "browser_caches": [{"browser": "Chrome", "size_mb": 400}, {"browser": "Edge", "size_mb": 200}], "memory": {"percent_used": 40}, "network": {"connectivity": {"internet_reachable": true}}, "dns_cache": {"entries": 0}, "update_leftovers": {"windows_old_present": false, "windows_update_cache_mb": 0, "delivery_optimization_mb": 0} },
      "includes": ["clear_all_browser_caches", "clear_chrome_cache", "clear_edge_cache"],
