<Window x:Class="ProntoPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProntoPC"
        Title="Pronto PC" Height="920" Width="640" MinHeight="680" MinWidth="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#070a18" FontFamily="Segoe UI">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,18,0,0" FontWeight="Bold" FontSize="16" Panel.ZIndex="10">
      <Run Text="PRONTO " Foreground="#eef1ff"/><Run Text="PC" Foreground="#a78bfa"/>
    </TextBlock>

    <Grid Margin="0,46,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="298"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- THE ACTUATOR — the Custodian, persistent across every phase. Its state and
           caption are set ONLY from real pipeline events (scan / plan / repair). -->
      <local:Custodian x:Name="Cust" Grid.Row="0" Margin="0,2,0,0"/>

      <!-- CONTENT REGION — interactive controls for the current phase, swapped in place. -->
      <Grid Grid.Row="1" Margin="0,2,0,0">

        <!-- Working-phase character art. Shown only during non-interactive work
             (scan / plan authoring, and repair); every ShowPanel/CollapseAllPanels
             hides it, so it never overlaps an interactive panel. Set from code. -->
        <Image x:Name="WorkingArt" Visibility="Collapsed"
               VerticalAlignment="Bottom" HorizontalAlignment="Center"
               Margin="0,0,0,12" MaxHeight="360" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>

        <!-- GATE (pay-per-run) — a run is unlocked by a one-time Stripe checkout. -->
        <StackPanel x:Name="GatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
          <!-- Start state -->
          <StackPanel x:Name="GateStart">
            <TextBlock Text="Ready to service your PC." Foreground="#eef1ff" FontSize="23"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="A one-time diagnostic and full repair, built for your PC by on-device AI. One flat price — no subscription, no add-ons."
                       Foreground="#c3c8e6" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="ProntoPC is an AI-centric computer-repair platform engineered on the AEGIS Framework. Its embedded repair model is designed for AEGIS Canon-aligned guidance. The Technician architecture flows through PIM, IRG, and RBC. PRISM represents the State of Flow: resonance allows Flow through the PRISM; incoherence cannot resonate and IDS reroutes it to its originator. The interactive Technician remains closed until its governance gate is explicitly enabled."
                       Foreground="#8b8fb0" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="12,12,12,0"/>
            <Button x:Name="GateBuyButton" Content="Start your $29 diagnostic" Click="GateBuy_Click"
                    Height="52" FontSize="17" FontWeight="Bold" Foreground="#ffffff" Cursor="Hand" Margin="0,20,0,0">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7c5cff" Offset="0"/>
                  <GradientStop Color="#4f7dff" Offset="1"/>
                </LinearGradientBrush>
              </Button.Background>
            </Button>
            <TextBlock Text="Secure checkout via Stripe. You'll return here automatically after paying."
                       Foreground="#8b8fb0" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
          <!-- Waiting state (browser checkout open; the app polls until payment lands) -->
          <StackPanel x:Name="GateWaiting" Visibility="Collapsed">
            <TextBlock Text="Waiting for your payment…" Foreground="#eef1ff" FontSize="21"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Complete the secure Stripe checkout in your browser. This window continues on its own the moment your payment is confirmed."
                       Foreground="#c3c8e6" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="GateReopenButton" Content="Reopen checkout" Click="GateBuy_Click"
                    Height="44" Width="200" Margin="0,18,0,0"
                    Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
            <Button Content="Cancel" Click="GateCancel_Click" Height="38" Width="140" Margin="0,10,0,0"
                    Foreground="#8b8fb0" Background="#0d1024" Cursor="Hand" HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="support@prontopc.online" Foreground="#a78bfa" FontSize="12"
                     TextAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- FINDINGS -->
        <ScrollViewer x:Name="FindingsPanel" Visibility="Collapsed" Margin="24,2,24,18" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Here's what we found." Foreground="#eef1ff" FontSize="21" FontWeight="Bold"/>
            <TextBlock x:Name="FindingsSummary" Foreground="#c3c8e6" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,12"/>
            <TextBlock Text="Recommended repairs — uncheck anything you'd rather skip:" Foreground="#eef1ff" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <!-- The repair list is a clearly visible, OPEN panel: every item the app will run
                 is shown here as its own card, so the whole plan reads at a glance. No nested
                 scroll box squeezing it — the panel below scrolls as one if it runs long. -->
            <Border Background="#0e1130" BorderBrush="#2f356a" BorderThickness="1" CornerRadius="12" Padding="10,10,10,2" Margin="0,0,0,12">
              <StackPanel x:Name="ActionList"/>
            </Border>
            <StackPanel>
            <TextBlock x:Name="FindingsTotal" Foreground="#5be3a0" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

            <!-- Technician conversation (§8 OPENED, TOTEM-C-0142/-0144): the findings step IS
                 the live on-device Technician. Grounded opening (factual, no model call), then
                 real Q&amp;A — inbound PIM-screened, outbound RBC/Prism-shaped. The checklist above
                 stays visible so Start Repair runs only what is approved. Nothing here executes an
                 action (Manifest I2): Start Repair is the explicit consent, Skip Repair declines. -->
            <Border Background="#171a3c" BorderBrush="#5b52a6" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,4,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="&#128172;" FontSize="18" Margin="0,0,8,0"/>
                  <TextBlock Text="Talk to your AI Technician" Foreground="#eef1ff"
                             FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="#0b0e24" BorderBrush="#2a2f55" BorderThickness="1" CornerRadius="8" Padding="10,8">
                  <ScrollViewer x:Name="ChatScroll" MinHeight="140" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatLog"/>
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </Border>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ChatInput" Grid.Column="0" Height="42" Background="#12142c" Foreground="#eef1ff"
                       BorderBrush="#2a2f55" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                       FontSize="13.5" KeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged"/>
              <!-- Placeholder hint so the box reads as the chat input; hidden as soon as the customer types. -->
              <TextBlock x:Name="ChatPlaceholder" Grid.Column="0" Text="Enter your question here…"
                         Foreground="#8b8fb0" FontSize="13.5" IsHitTestVisible="False"
                         VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
              <Button x:Name="ChatSendButton" Grid.Column="1" Content="Send" Click="ChatSend_Click"
                      Height="42" Width="76" Margin="8,0,0,0" Foreground="#ffffff" FontWeight="Bold" Cursor="Hand">
                <Button.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7c5cff" Offset="0"/><GradientStop Color="#4f7dff" Offset="1"/>
                  </LinearGradientBrush>
                </Button.Background>
              </Button>
            </Grid>
            <Button x:Name="ProceedButton" Content="Start Repair" Click="Proceed_Click"
                    Height="50" FontSize="17" FontWeight="Bold" Foreground="#ffffff" Cursor="Hand">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7c5cff" Offset="0"/>
                  <GradientStop Color="#4f7dff" Offset="1"/>
                </LinearGradientBrush>
              </Button.Background>
            </Button>
            <Button x:Name="SkipRepairButton" Content="Skip Repair" Click="SkipRepair_Click"
                    Height="44" FontSize="14" Foreground="#eef1ff" Background="#20233f" BorderBrush="#3a3f66"
                    BorderThickness="1" Cursor="Hand" Margin="0,8,0,0"/>
            <TextBlock Text="Uncheck any item above you'd rather not run. Nothing runs until you choose Start Repair."
                       Foreground="#c3c8e6" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock TextAlignment="Center" Margin="0,4,0,0" FontSize="11">
              <Hyperlink Click="OpenLicenses_Click" Foreground="#8b8fb0" TextDecorations="Underline">AI model &amp; licenses</Hyperlink>
            </TextBlock>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- COMPLETE -->
        <StackPanel x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
          <Image Source="pack://application:,,,/Assets/pronto-thumbsup.png" Height="210"
                 HorizontalAlignment="Center" Margin="0,0,0,4"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="✓ Your PC has been serviced." Foreground="#eef1ff" FontSize="23" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock x:Name="CompleteText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <!-- Opens the server-rendered repair report saved to the Desktop (repair path only; hidden on Skip). -->
          <Button x:Name="OpenReportButton" Content="Open Report" Click="OpenReport_Click" Visibility="Collapsed"
                  Height="48" Width="220" FontSize="15" FontWeight="Bold" Foreground="#ffffff" Cursor="Hand"
                  HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#7c5cff" Offset="0"/><GradientStop Color="#4f7dff" Offset="1"/>
              </LinearGradientBrush>
            </Button.Background>
          </Button>
          <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,12,0,0"
                  Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ERROR -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
          <TextBlock x:Name="ErrorText" Foreground="#eef1ff" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="support@prontopc.online" Foreground="#a78bfa" FontSize="12" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- MAKE-GOOD (AI unavailable — honest recourse, never a rule-based plan) -->
        <!-- RETRY (transient AI miss — offer another attempt before make-good) -->
        <StackPanel x:Name="RetryPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
          <TextBlock Text="Let's try that again." Foreground="#eef1ff" FontSize="21"
                     FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="Your AI plan didn't build that time — nothing on your PC has changed. This usually clears on another try."
                     Foreground="#c3c8e6" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <Border Background="#12142c" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="If it happens again, try one of these:" Foreground="#8b8fb0" FontSize="11"
                         FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,6"/>
              <TextBlock Foreground="#c3c8e6" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20">
                • Close other heavy apps (browsers, games) and try once more<LineBreak/>
                • Restart your computer, then open Pronto PC and run it again
              </TextBlock>
            </StackPanel>
          </Border>
          <Button Content="Try Again" Click="RetryAuthor_Click" Height="46" Width="200" Margin="0,20,0,0"
                  Foreground="#ffffff" Background="#7c5cff" Cursor="Hand" HorizontalAlignment="Center"/>
          <TextBlock TextAlignment="Center" Margin="0,14,0,0" FontSize="12">
            <Hyperlink Click="GiveUpToMakeGood_Click" Foreground="#8b8fb0" TextDecorations="Underline">Still stuck? Get your free-repair coupon</Hyperlink>
          </TextBlock>
        </StackPanel>

        <!-- MAKE-GOOD (AI unavailable — honest recourse, never a rule-based plan) -->
        <StackPanel x:Name="MakeGoodPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
          <TextBlock Text="Your AI plan didn't run this time." Foreground="#eef1ff" FontSize="21"
                     FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="MakeGoodText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center"
                     TextWrapping="Wrap" Margin="0,12,0,0"/>
          <Border x:Name="MakeGoodCodeBox" Visibility="Collapsed" Background="#12142c" CornerRadius="10"
                  Padding="18,14" Margin="0,16,0,0" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="YOUR FREE-REPAIR CODE" Foreground="#8b8fb0" FontSize="10"
                         TextAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="MakeGoodCode" Foreground="#5be3a0" FontSize="24" FontWeight="Bold"
                         FontFamily="Consolas,Courier New,monospace" TextAlignment="Center"/>
              <TextBlock Text="100% off · single use" Foreground="#8b8fb0"
                         FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock TextAlignment="Center" Margin="0,14,0,0" FontSize="12.5">
            <Hyperlink Click="RequestRefund_Click" Foreground="#a78bfa" TextDecorations="Underline">Prefer your money back? Request a refund</Hyperlink>
          </TextBlock>
          <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,18,0,0"
                  Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
          <TextBlock TextAlignment="Center" Margin="0,10,0,0" FontSize="11">
            <Hyperlink Click="OpenLicenses_Click" Foreground="#8b8fb0" TextDecorations="Underline">AI model &amp; licenses</Hyperlink>
          </TextBlock>
        </StackPanel>

        <!-- REFUND OUTCOME (result of a self-service refund request) -->
        <StackPanel x:Name="RefundPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
          <TextBlock x:Name="RefundTitle" Text="Refund" Foreground="#eef1ff" FontSize="21"
                     FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="RefundText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center"
                     TextWrapping="Wrap" Margin="0,12,0,0"/>
          <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,22,0,0"
                  Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
        </StackPanel>


      </Grid>
    </Grid>
  </Grid>
</Window>
