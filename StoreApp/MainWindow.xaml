<Window x:Class="ProntoPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProntoPC"
        Title="Pronto PC" Height="760" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#070a18" FontFamily="Segoe UI">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,18,0,0" FontWeight="Bold" FontSize="16" Panel.ZIndex="10">
      <Run Text="PRONTO " Foreground="#eef1ff"/><Run Text="PC" Foreground="#a78bfa"/>
    </TextBlock>

    <Grid Margin="0,46,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="298"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- THE ACTUATOR — the Custodian, persistent across every phase. Its state and
           caption are set ONLY from real pipeline events (scan / plan / repair). -->
      <local:Custodian x:Name="Cust" Grid.Row="0" Margin="0,2,0,0"/>

      <!-- CONTENT REGION — interactive controls for the current phase, swapped in place. -->
      <Grid Grid.Row="1" Margin="0,2,0,0">

        <!-- GATE (pay-per-run) — a run is unlocked by a one-time Stripe checkout. -->
        <StackPanel x:Name="GatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
          <!-- Start state -->
          <StackPanel x:Name="GateStart">
            <TextBlock Text="Ready to service your PC." Foreground="#eef1ff" FontSize="23"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="A one-time diagnostic and full repair, built for your PC by on-device AI. One flat price — no subscription, no add-ons."
                       Foreground="#c3c8e6" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="GateBuyButton" Content="Start your $29 diagnostic" Click="GateBuy_Click"
                    Height="52" FontSize="17" FontWeight="Bold" Foreground="#ffffff" Cursor="Hand" Margin="0,20,0,0">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7c5cff" Offset="0"/>
                  <GradientStop Color="#4f7dff" Offset="1"/>
                </LinearGradientBrush>
              </Button.Background>
            </Button>
            <TextBlock Text="Secure checkout via Stripe. You'll return here automatically after paying."
                       Foreground="#8b8fb0" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
          <!-- Waiting state (browser checkout open; the app polls until payment lands) -->
          <StackPanel x:Name="GateWaiting" Visibility="Collapsed">
            <TextBlock Text="Waiting for your payment…" Foreground="#eef1ff" FontSize="21"
                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Complete the secure Stripe checkout in your browser. This window continues on its own the moment your payment is confirmed."
                       Foreground="#c3c8e6" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="GateReopenButton" Content="Reopen checkout" Click="GateBuy_Click"
                    Height="44" Width="200" Margin="0,18,0,0"
                    Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
            <Button Content="Cancel" Click="GateCancel_Click" Height="38" Width="140" Margin="0,10,0,0"
                    Foreground="#8b8fb0" Background="#0d1024" Cursor="Hand" HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="support@prontopc.online" Foreground="#a78bfa" FontSize="12"
                     TextAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- FINDINGS -->
        <Grid x:Name="FindingsPanel" Visibility="Collapsed" Margin="24,2,24,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Here's what we found." Foreground="#eef1ff" FontSize="21" FontWeight="Bold"/>
            <TextBlock x:Name="FindingsSummary" Foreground="#c3c8e6" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,12"/>
            <TextBlock Text="Recommended repairs — uncheck anything you'd rather skip:" Foreground="#c3c8e6" FontSize="12" Margin="0,0,0,8"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ActionList"/>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FindingsTotal" Foreground="#5be3a0" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
            <Button x:Name="ProceedButton" Content="Perform Repairs" Click="Proceed_Click"
                    Height="50" FontSize="17" FontWeight="Bold" Foreground="#ffffff" Cursor="Hand">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7c5cff" Offset="0"/>
                  <GradientStop Color="#4f7dff" Offset="1"/>
                </LinearGradientBrush>
              </Button.Background>
            </Button>
            <TextBlock Text="Permission is already granted — repairs run immediately."
                       Foreground="#c3c8e6" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock TextAlignment="Center" Margin="0,4,0,0" FontSize="11">
              <Hyperlink Click="OpenLicenses_Click" Foreground="#8b8fb0" TextDecorations="Underline">AI model &amp; licenses</Hyperlink>
            </TextBlock>
            <!-- Entry to the conversational Technician (Phase 2). Hidden until a real
                 IPeerGovernance opens the AEGIS §8 gate, so no ungoverned chat is reachable. -->
            <TextBlock x:Name="TechnicianEntry" TextAlignment="Center" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed">
              <Hyperlink Click="OpenChat_Click" Foreground="#a78bfa" TextDecorations="Underline">Ask the Technician about this plan</Hyperlink>
            </TextBlock>
          </StackPanel>
        </Grid>

        <!-- COMPLETE -->
        <StackPanel x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
          <TextBlock Text="✓ Your PC has been serviced." Foreground="#eef1ff" FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
          <TextBlock x:Name="CompleteText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,22,0,0"
                  Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ERROR -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
          <TextBlock x:Name="ErrorText" Foreground="#eef1ff" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="support@prontopc.online" Foreground="#a78bfa" FontSize="12" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- MAKE-GOOD (AI unavailable — honest recourse, never a rule-based plan) -->
        <StackPanel x:Name="MakeGoodPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
          <TextBlock Text="Your AI plan didn't run this time." Foreground="#eef1ff" FontSize="21"
                     FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="MakeGoodText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center"
                     TextWrapping="Wrap" Margin="0,12,0,0"/>
          <Border x:Name="MakeGoodCodeBox" Visibility="Collapsed" Background="#12142c" CornerRadius="10"
                  Padding="18,14" Margin="0,16,0,0" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="YOUR FREE-REPAIR CODE" Foreground="#8b8fb0" FontSize="10"
                         TextAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="MakeGoodCode" Foreground="#5be3a0" FontSize="24" FontWeight="Bold"
                         FontFamily="Consolas,Courier New,monospace" TextAlignment="Center"/>
              <TextBlock Text="100% off · single use" Foreground="#8b8fb0"
                         FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,20,0,0"
                  Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
          <TextBlock TextAlignment="Center" Margin="0,10,0,0" FontSize="11">
            <Hyperlink Click="OpenLicenses_Click" Foreground="#8b8fb0" TextDecorations="Underline">AI model &amp; licenses</Hyperlink>
          </TextBlock>
        </StackPanel>

        <!-- TECHNICIAN CONVERSATION (Phase 2) — built + wired, but GATED. Reachable only
             once a real IPeerGovernance opens the AEGIS §8 admission gate; every inbound is
             PIM-screened and every reply passes RBC/Prism before it is shown. Nothing here
             executes an action — conversation only (Executable Boundaries / Manifest I2). -->
        <Grid x:Name="ChatPanel" Visibility="Collapsed" Margin="24,2,24,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Talk to your Technician" Foreground="#eef1ff" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
          <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatLog"/>
          </ScrollViewer>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ChatInput" Grid.Column="0" Height="42" Background="#12142c" Foreground="#eef1ff"
                     BorderBrush="#2a2f55" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                     FontSize="13.5" KeyDown="ChatInput_KeyDown"/>
            <Button x:Name="ChatSendButton" Grid.Column="1" Content="Send" Click="ChatSend_Click"
                    Height="42" Width="76" Margin="8,0,0,0" Foreground="#ffffff" FontWeight="Bold" Cursor="Hand">
              <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7c5cff" Offset="0"/><GradientStop Color="#4f7dff" Offset="1"/>
                </LinearGradientBrush>
              </Button.Background>
            </Button>
            <Button Grid.Column="2" Content="Back" Click="ChatBack_Click" Height="42" Width="66" Margin="8,0,0,0"
                    Foreground="#eef1ff" Background="#12142c" Cursor="Hand"/>
          </Grid>
        </Grid>

      </Grid>
    </Grid>
  </Grid>
</Window>
