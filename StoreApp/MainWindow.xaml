<Window x:Class="ProntoPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pronto PC" Height="700" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#051424" FontFamily="Segoe UI">

  <Window.Resources>
    <Storyboard x:Key="Spin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:1.1"/>
    </Storyboard>
    <Style TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource Spin}"/>
    </EventTrigger>
  </Window.Triggers>

  <Grid>
    <TextBlock Text="PRONTO PC" Foreground="#d4e4fa" FontWeight="Bold" FontSize="16"
               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,18,0,0"/>

    <!-- WORKING (scan / repair) — swap the ring for the mascot GIF later -->
    <StackPanel x:Name="WorkingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
      <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,28">
        <Ellipse Width="120" Height="120" Stroke="#122131" StrokeThickness="10"/>
        <Ellipse Width="120" Height="120" Stroke="#91db2a" StrokeThickness="10" StrokeDashArray="4 3"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Ellipse.RenderTransform>
        </Ellipse>
        <TextBlock Text="PC" Foreground="#ffb95f" FontWeight="Bold" FontSize="30"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock x:Name="WorkingTitle" Text="Reading your system…" Foreground="#d4e4fa"
                 FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="WorkingSub" Text="This takes about a minute. Nothing is changed."
                 Foreground="#8b9ab5" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>

    <!-- FINDINGS -->
    <Grid x:Name="FindingsPanel" Visibility="Collapsed" Margin="24,56,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock Text="Here's what we found." Foreground="#d4e4fa" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="FindingsSummary" Foreground="#8b9ab5" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,14"/>
        <TextBlock Text="Recommended repairs — uncheck anything you'd rather skip:" Foreground="#8b9ab5" FontSize="12" Margin="0,0,0,8"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ActionList"/>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock x:Name="FindingsTotal" Foreground="#91db2a" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
        <Button x:Name="ProceedButton" Content="Perform Repairs" Click="Proceed_Click"
                Height="52" FontSize="17" FontWeight="Bold" Foreground="#051424" Background="#91db2a" Cursor="Hand"/>
        <TextBlock Text="Permission is already granted — repairs run immediately."
                   Foreground="#8b9ab5" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Grid>

    <!-- COMPLETE -->
    <StackPanel x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
      <TextBlock Text="✓" Foreground="#91db2a" FontSize="64" TextAlignment="Center"/>
      <TextBlock Text="Your PC has been serviced." Foreground="#d4e4fa" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock x:Name="CompleteText" Foreground="#8b9ab5" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,24,0,0"
              Foreground="#d4e4fa" Background="#122131" Cursor="Hand" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- ERROR -->
    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
      <TextBlock Text="⚠" Foreground="#ffb95f" FontSize="52" TextAlignment="Center"/>
      <TextBlock x:Name="ErrorText" Foreground="#d4e4fa" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="support@prontopc.online" Foreground="#ffb95f" FontSize="12" TextAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
  </Grid>
</Window>
