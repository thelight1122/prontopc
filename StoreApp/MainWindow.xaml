<Window x:Class="ProntoPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pronto PC" Height="700" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#070a18" FontFamily="Segoe UI">

  <Window.Resources>
    <Storyboard x:Key="Spin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:1.1"/>
    </Storyboard>
    <Style TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource Spin}"/>
    </EventTrigger>
  </Window.Triggers>

  <Grid>
    <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,18,0,0" FontWeight="Bold" FontSize="16">
      <Run Text="PRONTO " Foreground="#eef1ff"/><Run Text="PC" Foreground="#a78bfa"/>
    </TextBlock>

    <!-- WORKING (scan / repair) — the Auditor technician inside a scanning aura -->
    <StackPanel x:Name="WorkingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
      <Grid Width="320" Height="320" HorizontalAlignment="Center" Margin="0,0,0,18">
        <Ellipse Width="300" Height="300" Stroke="#12142c" StrokeThickness="8"/>
        <Ellipse Width="300" Height="300" Stroke="#8b6bff" StrokeThickness="8" StrokeDashArray="4 3"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Ellipse.RenderTransform>
        </Ellipse>
        <Image x:Name="WorkingAuditor" Source="pack://application:,,,/Assets/auditor.png" Height="300"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="WorkingBuilder" Source="pack://application:,,,/Assets/builder.png" Height="300"
               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
      <TextBlock x:Name="WorkingTitle" Text="Reading your system…" Foreground="#eef1ff"
                 FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="WorkingSub" Text="This takes about a minute. Nothing is changed."
                 Foreground="#c3c8e6" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>

    <!-- FINDINGS -->
    <Grid x:Name="FindingsPanel" Visibility="Collapsed" Margin="24,56,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock Text="Here's what we found." Foreground="#eef1ff" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="FindingsSummary" Foreground="#c3c8e6" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,14"/>
        <TextBlock Text="Recommended repairs — uncheck anything you'd rather skip:" Foreground="#c3c8e6" FontSize="12" Margin="0,0,0,8"/>
      </StackPanel>
      <!-- Auditor technician presence, behind the list (never blocks the checkboxes) -->
      <Image Grid.Row="1" Source="pack://application:,,,/Assets/auditor.png" Height="240"
             HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.9"
             IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,4"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ActionList"/>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock x:Name="FindingsTotal" Foreground="#5be3a0" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
        <Button x:Name="ProceedButton" Content="Perform Repairs" Click="Proceed_Click"
                Height="52" FontSize="17" FontWeight="Bold" Foreground="#ffffff" Cursor="Hand">
          <Button.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#7c5cff" Offset="0"/>
              <GradientStop Color="#4f7dff" Offset="1"/>
            </LinearGradientBrush>
          </Button.Background>
        </Button>
        <TextBlock Text="Permission is already granted — repairs run immediately."
                   Foreground="#c3c8e6" FontSize="11" TextAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock TextAlignment="Center" Margin="0,4,0,0" FontSize="11">
          <Hyperlink Click="OpenLicenses_Click" Foreground="#8b8fb0" TextDecorations="Underline">AI model &amp; licenses</Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- COMPLETE -->
    <StackPanel x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
      <Image Source="pack://application:,,,/Assets/builder.png" Height="210"
             HorizontalAlignment="Center" Margin="0,0,0,4"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="✓ Your PC has been serviced." Foreground="#eef1ff" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
      <TextBlock x:Name="CompleteText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,24,0,0"
              Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- ERROR -->
    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
      <TextBlock Text="⚠" Foreground="#ff7a7a" FontSize="52" TextAlignment="Center"/>
      <TextBlock x:Name="ErrorText" Foreground="#eef1ff" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="support@prontopc.online" Foreground="#a78bfa" FontSize="12" TextAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>

    <!-- MAKE-GOOD (AI unavailable — honest recourse, never a rule-based plan) -->
    <StackPanel x:Name="MakeGoodPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
      <Image Source="pack://application:,,,/Assets/auditor.png" Height="180"
             HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.95"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Your AI plan didn't run this time." Foreground="#eef1ff" FontSize="22"
                 FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="MakeGoodText" Foreground="#c3c8e6" FontSize="14" TextAlignment="Center"
                 TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Border x:Name="MakeGoodCodeBox" Visibility="Collapsed" Background="#12142c" CornerRadius="10"
              Padding="18,14" Margin="0,16,0,0" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="YOUR FREE-REPAIR CODE" Foreground="#8b8fb0" FontSize="10"
                     TextAlignment="Center" Margin="0,0,0,4"/>
          <TextBlock x:Name="MakeGoodCode" Foreground="#5be3a0" FontSize="24" FontWeight="Bold"
                     FontFamily="Consolas,Courier New,monospace" TextAlignment="Center"/>
          <TextBlock x:Name="MakeGoodCodeSub" Text="100% off · single use" Foreground="#8b8fb0"
                     FontSize="11" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Button Content="Close" Click="Close_Click" Height="44" Width="150" Margin="0,22,0,0"
              Foreground="#eef1ff" Background="#12142c" Cursor="Hand" HorizontalAlignment="Center"/>
      <TextBlock Text="support@prontopc.online" Foreground="#a78bfa" FontSize="12"
                 TextAlignment="Center" Margin="0,12,0,0"/>
      <TextBlock TextAlignment="Center" Margin="0,4,0,0" FontSize="11">
        <Hyperlink Click="OpenLicenses_Click" Foreground="#8b8fb0" TextDecorations="Underline">AI model &amp; licenses</Hyperlink>
      </TextBlock>
    </StackPanel>
  </Grid>
</Window>
