<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <AssemblyName>ProntoPC</AssemblyName>
    <RootNamespace>ProntoPC</RootNamespace>
    <ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>4</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI access for the native diagnostic collector (Diagnostics.cs) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- On-device inference for the local-model Satellite (OnnxGenAiInference.cs) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Canon-formed Gemma responder.  The v0.2.1 LoRA is merged into this CPU/INT4
         ONNX export; its formation provenance travels with the model folder. The IRG's
         analyzer research model (gemma-3-1b-analyzer, TOTEM-C-0092+) also lives under
         Assets\models\ for the on-device smoke, but it is NOT part of the shipped product
         (governance gate enabled:false) and must NOT be packaged. -->
    <Content Remove="Assets\models\**\*" />
    <Content Include="Assets\models\gemma-3-1b-it-formed-v0.2.1\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Product Nature Layer: bounded evidence-domain context, supplied at runtime. -->
    <Content Include="..\pod\orbs\repair-plan\satellites\local-model\education\nature-layer\repair-nature-layer.json"
             Link="Assets\aegis\repair-nature-layer.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled AI-model + third-party license notices (Gemma Terms of Use +
         Prohibited Use Policy). Shipped in every install so the required notices
         travel with the distribution; also opened in-app from the "AI model &
         licenses" link. -->
    <Content Include="Assets\licenses\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Character AI presence: Auditor (scan/findings), Builder (repair complete) -->
    <Resource Include="Assets\auditor.png" />
    <Resource Include="Assets\builder.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Action Envelope: the single source of truth (authored by the repair-engine Orb)
         embedded by Link so the client keys to the same file, never a drifting copy.
         Envelope.Load() reads it; the Orchestrator keys the plan Umbilical to it. -->
    <EmbeddedResource Include="..\pod\orbs\repair-engine\action-envelope.json" Link="action-envelope.json" />
  </ItemGroup>

</Project>
