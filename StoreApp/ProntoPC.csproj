<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <AssemblyName>ProntoPC</AssemblyName>
    <RootNamespace>ProntoPC</RootNamespace>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI access for the native diagnostic collector (Diagnostics.cs) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- On-device inference for the local-model Satellite (OnnxGenAiInference.cs) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Gemma model (Stage 2b). Globs nothing until the weights are placed in
         Assets\models\gemma-3-1b-it\ (genai_config.json + model.onnx + tokenizer). -->
    <Content Include="Assets\models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Character AI presence: Auditor (scan/findings), Builder (repair complete) -->
    <Resource Include="Assets\auditor.png" />
    <Resource Include="Assets\builder.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Action Envelope: the single source of truth (authored by the repair-engine Orb)
         embedded by Link so the client keys to the same file, never a drifting copy.
         Envelope.Load() reads it; the Orchestrator keys the plan Umbilical to it. -->
    <EmbeddedResource Include="..\pod\orbs\repair-engine\action-envelope.json" Link="action-envelope.json" />
  </ItemGroup>

</Project>
