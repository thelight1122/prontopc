# Keep line endings LF in the working tree on every platform. The Totem verifier
# hashes working-copy bytes; a CRLF checkout on Windows would flip those bytes and
# report false drift. eol=lf pins them so the recorded SHA-256s stay stable.
* text=auto eol=lf

# Binaries: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.msix binary
*.cer binary
*.pdf binary
